# ─── База данных ───
# Локально SQLite. В проде заменить на postgresql://... и сменить provider в schema.prisma
DATABASE_URL="file:./dev.db"

# ─── Auth.js ───
# Сгенерировать: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ─── Telegram ───
# Токен бота от @BotFather. Нужен и для оплаты, и для входа через Telegram Login.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Токен платёжного провайдера (Click/Payme), выдаётся ботом @BotFather.
# ПУСТО = режим песочницы: оплата имитируется локально, бот и HTTPS не нужны.
TELEGRAM_PROVIDER_TOKEN=""
# Произвольная строка; Telegram присылает её в заголовке X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=""
# Чат (id), куда бот пишет об оплаченных заказах. Можно оставить пустым.
TELEGRAM_ADMIN_CHAT_ID=""

# ─── Скрытая админ-панель ───
# Сегмент URL панели. Панель доступна по /<локаль>/<ADMIN_PATH>.
# Любой другой путь и любой не-администратор получают 404, а не 403,
# чтобы сам факт существования панели не раскрывался.
# Сгенерировать случайную строку, напр.: node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))"
ADMIN_PATH=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
